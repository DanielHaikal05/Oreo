<?xml version="1.0"?>
<sdf version="1.9">
  <world name="oreo_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin 
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="oreo">
      <static>false</static>  
      <pose>0 0 0.03 0 0 0</pose>

      <link name="base_link">
        <inertial>
          <mass>0.8</mass>
          <inertia>
            <ixx>0.01</ixx>
            <iyy>0.01</iyy>
            <izz>0.02</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>

        <visual name="base_visual">
          <geometry>
            <polyline>
              <height>0.07</height>
              <point>0.125 0.025</point>
              <point>-0.04084936491 0.1207531755</point>
              <point>-0.08415063509 0.09575317547</point>
              <point>-0.08415063509 -0.09575317547</point>
              <point>-0.04084936491 -0.1207531755</point>
              <point>0.125 -0.025</point>
            </polyline>
          </geometry>
          <material>
            <ambient>0.1 0.4 0.8 1</ambient>
            <diffuse>0.1 0.4 0.8 1</diffuse>
          </material>
        </visual>

        <collision name="base_collision">
          <geometry>
            <polyline>
              <height>0.07</height>
              <point>0.125 0.025</point>
              <point>-0.04084936491 0.1207531755</point>
              <point>-0.08415063509 0.09575317547</point>
              <point>-0.08415063509 -0.09575317547</point>
              <point>-0.04084936491 -0.1207531755</point>
              <point>0.125 -0.025</point>
            </polyline>
          </geometry>
        </collision>
        
        <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>1</update_rate>      <visualize>true</visualize>       <topic>imu</topic>                </sensor>

      <sensor name='gpu_lidar' type='gpu_lidar'>
        <pose relative_to='lidar_frame'>0 0 0 0 0 0</pose>
        <topic>lidar</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>640</samples>
              <resolution>1</resolution>
              <min_angle>-1.396263</min_angle>
              <max_angle>1.396263</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>0.01</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.08</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
      </link>

      <link name="wheel_1">
        <pose relative_to="base_link">0.1375 0 0.03 0 1.5708 0</pose>
        <inertial>
          <mass>0.24821</mass>
          <inertia>
            <ixx>0.0001681</ixx>
            <iyy>0.0001681</iyy>
            <izz>0.0003103</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="wheel_1_visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.025</length>
            </cylinder>
          </geometry>
        </visual>
        <collision name="wheel_1_collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.025</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <fdir1>0 0 1</fdir1>
                <mu>0.03</mu>
                <mu2>1.0</mu2>
                <slip1>0.01</slip1>
                <slip2>0.0</slip2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <joint name="wheel_1_joint" type="revolute">
        <parent>base_link</parent>
        <child>wheel_1</child>
        <axis>
          <xyz expressed_in="base_link">1 0 0</xyz>
          <dynamics>
            <damping>0.01</damping>
            <friction>0.0</friction>
          </dynamics>
        </axis>
      </joint>

      <link name="wheel_2">
        <pose relative_to="base_link">-0.06875 0.119078 0.03 0 1.5708 2.094395</pose>
        <inertial>
          <mass>0.24821</mass>
          <inertia>
            <ixx>0.0001681</ixx>
            <iyy>0.0001681</iyy>
            <izz>0.0003103</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="wheel_2_visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.025</length>
            </cylinder>
          </geometry>
        </visual>
        <collision name="wheel_2_collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.025</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <fdir1>0 0 1</fdir1>
                <mu>0.03</mu>
                <mu2>1.0</mu2>
                <slip1>0.01</slip1>
                <slip2>0.0</slip2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <joint name="wheel_2_joint" type="revolute">
        <parent>base_link</parent>
        <child>wheel_2</child>
        <axis>
          <xyz expressed_in="base_link">-0.5 0.866025 0</xyz>
          <dynamics>
            <damping>0.01</damping>
            <friction>0.0</friction>
          </dynamics>
        </axis>
      </joint>

      <link name="wheel_3">
        <pose relative_to="base_link">-0.06875 -0.119078 0.03 0 1.5708 4.188790</pose>
        <inertial>
          <mass>0.24821</mass>
          <inertia>
            <ixx>0.0001681</ixx>
            <iyy>0.0001681</iyy>
            <izz>0.0003103</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="wheel_3_visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.025</length>
            </cylinder>
          </geometry>
        </visual>
        <collision name="wheel_3_collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.025</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <fdir1>0 0 1</fdir1>
                <mu>0.03</mu>
                <mu2>1.0</mu2>
                <slip1>0.01</slip1>
                <slip2>0.0</slip2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <joint name="wheel_3_joint" type="revolute">
        <parent>base_link</parent>
        <child>wheel_3</child>
        <axis>
          <xyz expressed_in="base_link">-0.5 -0.866025 0</xyz>
          <dynamics>
            <damping>0.01</damping>
            <friction>0.0</friction>
          </dynamics>
        </axis>
      </joint>
    </model>
  </world>
</sdf>
